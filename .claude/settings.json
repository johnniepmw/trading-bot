{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.tfvars)",
      "Bash(gcloud secrets versions access *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "allow": [
      "Bash(make check*)",
      "Bash(make test*)",
      "Bash(make e2e*)",
      "Bash(make fmt*)",
      "Bash(make lint*)",
      "Bash(make typecheck*)",
      "Bash(make risk*)",
      "Bash(make docs-check*)",
      "Bash(make flags-check*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ]
  }
}
