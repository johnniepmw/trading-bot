{
  "name": "app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "e2e:setup": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "mutation": "stryker run"
  }
}
