# Copy to .env.local for local development (gitignored). Names only here, never values.
# Non-secret settings
PORT=8080
LOG_LEVEL=info
# APP_ENV=local lets FLAG_<NAME>=on and a missing FLAGS_BUCKET work; unset means deployed
APP_ENV=local
# Local flag overrides, e.g. FLAG_HOME_GREETING=false
# Secrets: in deployed environments these are files under /secrets/<name>/value.
# Locally, point SECRETS_DIR at a gitignored folder with the same layout.
SECRETS_DIR=./secrets
