# Copy to bootstrap.tfvars (gitignored) and fill in. None of these values are secret.
project_id        = "myapp-123456"
region            = "europe-west2"
app_name          = "myapp"
github_repository = "johnniepmw/myapp"
github_repository_id = "123456789"   # gh api repos/<owner>/<repo> --jq .id
github_owner_id      = "1234567"     # gh api repos/<owner>/<repo> --jq .owner.id
alert_email       = "you@example.com"
# billing_account = "000000-000000-000000"   # optional: enables a budget alert
# budget_amount   = 50
